# Used to sign session cookies. Generate a long random string in production.
AUTH_SECRET="replace-with-a-long-random-string"

# Database configuration:
# For production (Netlify/Serverless with Turso):
TURSO_DATABASE_URL="libsql://volunteer-hub-qitechco.aws-us-east-1.turso.io"
TURSO_AUTH_TOKEN="your-turso-database-auth-token"

# Optional local SQLite fallback (used automatically if TURSO_DATABASE_URL is unset):
# prisma/dev.db

# Web Push (VAPID). Generate with: npx web-push generate-vapid-keys
# If these are unset, Hub still installs as a PWA. Opt-in and the Test ping
# use a local Notification via the service worker (mock fallback).
# VAPID_PUBLIC_KEY=""
# VAPID_PRIVATE_KEY=""
# VAPID_SUBJECT="mailto:Dimple@DimpleAjmera.com"
